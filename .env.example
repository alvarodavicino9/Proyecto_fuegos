# Credenciales del proyecto de Supabase (Configuración del proyecto → API).
# Copiá este archivo a ".env.local" y completá los valores reales.
# Sin estos valores, el sitio funciona igual pero con los datos estáticos
# de /src/data (menú y datos del negocio fijos, sin panel admin operativo).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Opcional: analítica. Si los dejás vacíos o comentados, el sitio funciona
# igual, simplemente no manda datos a ningún lado.
# GA4: Google Analytics -> Administrar -> Flujos de datos -> tu flujo web (empieza con "G-")
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Meta Pixel: Events Manager -> Origenes de datos -> tu Pixel (un número largo)
# VITE_META_PIXEL_ID=1234567890123456
